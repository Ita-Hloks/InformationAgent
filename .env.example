# RSS 语义筛选、文章分析与问题规划
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 可选的哔哩哔哩评论接口 Cookie；代码不读取浏览器配置文件。
BILIBILI_COOKIE=

# 联网搜索回答
# 使用官方 OpenAI Responses API 时填写 openai_responses_web_search。
SEARCH_LLM_ADAPTER=openai_responses_web_search
SEARCH_LLM_API_KEY=
SEARCH_LLM_MODEL=
SEARCH_LLM_BASE_URL=https://api.openai.com/v1
SEARCH_LLM_RESULT_COUNT=5
SEARCH_LLM_CONTENT_SIZE=medium
SEARCH_LLM_TIMEOUT_SECONDS=300
